# Скопировать в v2/.env и заполнить: cp v2/.env.example v2/.env && chmod 600 v2/.env
# v2/.env в git не попадает. Это НЕ тот .env, что у v1 (корень репозитория).

# Postgres: пароли ролей hunter (ядро) и n8n (n8n v2). Сгенерировать: openssl rand -hex 24
POSTGRES_PASSWORD=
N8N_DB_PASSWORD=

# Ключ шифрования credentials n8n v2: openssl rand -hex 32 (сохрани в менеджер паролей)
N8N_ENCRYPTION_KEY=
# Секрет запросов n8n v2 → ядро (заголовок X-Internal-Token): openssl rand -hex 32
INTERNAL_TOKEN=

# Бот v2 — НОВЫЙ бот в @BotFather, не токен бота v1
TG_BOT_TOKEN=
# Твой Telegram id: первый администратор v2
ADMIN_TG_ID=

# Нейросеть (общий ключ на всех пользователей)
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# CLAUDE_MODEL=claude-haiku-4-5
