      "typeVersion": 2,
      "position": [
        0,
        200
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "v2-collect",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "5ea83430-18e1-1818-438e-0c41f1edcf62"
    },
    {
      "id": "4426caf3-8008-d771-04d9-a64c7180c9fa",
      "name": "Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const j = $input.first().json;\nif (j.body !== undefined) {\n  if ((j.headers || {})['x-internal-token'] !== $env.INTERNAL_TOKEN) throw new Error('v2-collect: неверный X-Internal-Token');\n  const b = j.body || {};\n  return [{ json: { kind: b.kind || 'bot', profile_id: b.profile_id ?? null, chat_id: b.chat_id ?? null } }];\n}\nreturn [{ json: { kind: 'schedule', profile_id: null, chat_id: null } }];"
      }
    },
    {
      "id": "a61a4a24-cef2-793c-1667-d44a1e777292",
      "name": "Plan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CORE_URL }}/internal/collect/plan",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "={{ $env.INTERNAL_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "3ccd644d-3619-4706-d1c4-89bb396f65da",
