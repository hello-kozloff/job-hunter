# Скопировать в .env и заполнить: cp .env.example .env
# .env в git не попадает.

# Версия образа n8n. После первого запуска лучше закрепить конкретную
# (Settings → About n8n), чтобы обновления не приходили сами.
N8N_VERSION=latest

# Ключ шифрования credentials. Сгенерировать: openssl rand -hex 32
# Без этого ключа сохранённые credentials не расшифровать — сохрани его в менеджер паролей.
N8N_ENCRYPTION_KEY=

# Твой chat_id в Telegram (этап 1, см. docs/stages/stage-1.md)
TG_CHAT_ID=

# Публичный адрес для вебхуков. Понадобится на этапе 4 (ngrok), пока localhost.
WEBHOOK_URL=http://localhost:5678/
