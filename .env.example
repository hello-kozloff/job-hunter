# Скопировать в .env и заполнить: cp .env.example .env
# .env в git не попадает. Права: chmod 600 .env

# Версия образа n8n. Закреплена, чтобы обновления не приходили сами.
# Обновить: поменять версию → docker compose pull && docker compose up -d
N8N_VERSION=2.42.3

# Ключ шифрования credentials. Сгенерировать: openssl rand -hex 32
# Без этого ключа сохранённые credentials не расшифровать — сохрани его в менеджер паролей.
N8N_ENCRYPTION_KEY=

# Твой chat_id в Telegram
TG_CHAT_ID=

# Токен бота от @BotFather. scripts/deploy.sh создаёт из него credential «Telegram bot» в n8n.
TG_BOT_TOKEN=

# Публичный адрес для вебхуков. С туннелем ngrok его выставляет `node scripts/n8n-api.mjs tunnel-env`
# (вызывается из scripts/deploy.sh) — вместе с COMPOSE_PROFILES=tunnel.
WEBHOOK_URL=http://localhost:5678/

# Туннель ngrok для кнопок Telegram (W3): https://dashboard.ngrok.com — Your Authtoken и Domains.
# Домен без https://, например name.ngrok-free.app
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Оценка вакансий (W2). Ключ Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Запасная нейросеть Claude (платная): ключ https://console.anthropic.com и LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=
# Страж healthchecks.io: Ping URL чека «job-hunter W1» (docs/stages/stage-5.md)
HC_PING_URL=
# LLM_PROVIDER=gemini
# GEMINI_MODEL=gemini-3.5-flash-lite
# CLAUDE_MODEL=claude-haiku-4-5

# Владелец локального n8n — дописывает `node scripts/n8n-api.mjs setup-owner <email>`.
# Этим логином/паролем входишь в http://localhost:5678, им же пользуются скрипты.
# N8N_OWNER_EMAIL=
# N8N_OWNER_PASSWORD=
