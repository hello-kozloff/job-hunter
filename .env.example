# Заполняет мастер установки: node scripts/install.mjs (сам создаёт .env из этого файла и спрашивает ключи).
# Вручную: cp .env.example .env && chmod 600 .env. В git .env не попадает.

# Имя установки и порт интерфейса n8n. Вторая установка рядом с первой — свои (мастер: --project jh-test --port 5690)
COMPOSE_PROJECT_NAME=job-hunter
N8N_PORT=5678

# Версия образа n8n. Закреплена, чтобы обновления не приходили сами.
# Обновить: поменять версию → docker compose pull && docker compose up -d
N8N_VERSION=2.42.3

# Ключ шифрования credentials. Сгенерировать: openssl rand -hex 32
# Без этого ключа сохранённые credentials не расшифровать — сохрани его в менеджер паролей.
N8N_ENCRYPTION_KEY=

# Твой chat_id в Telegram
TG_CHAT_ID=

# Часовой пояс компьютера (IANA, например Europe/Moscow, Asia/Bangkok): время в боте, тихие часы 23–09, сводка
# в 10:00, «день» робота. Пояс можно поменять и в боте (настройка profile.tz). Пусто — Москва
USER_TZ=

# Токен бота от @BotFather. scripts/deploy.sh создаёт из него credential «Telegram bot» в n8n.
TG_BOT_TOKEN=

# Публичный адрес для вебхуков. С туннелем ngrok его выставляет `node scripts/n8n-api.mjs tunnel-env`
# (вызывается из scripts/deploy.sh) — вместе с COMPOSE_PROFILES=tunnel.
WEBHOOK_URL=http://localhost:5678/

# Туннель ngrok для кнопок Telegram (W3): https://dashboard.ngrok.com — Your Authtoken и Domains.
# Домен без https://, например name.ngrok-free.app
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Нейросеть: оценка вакансий (W2), письма (W5), разбор резюме (W11). Ключ Gemini: https://aistudio.google.com/apikey
# Регионы: из РФ Gemini не работает (блок по IP), Claude запрещён правилами Anthropic; в ЕС, Великобритании и Швейцарии
# бесплатного Gemini нет — платный аккаунт или Claude
GEMINI_API_KEY=
# Запасная нейросеть Claude (платная): ключ https://console.anthropic.com; переключение — в боте: ⚙️ → 🤖 Нейросеть
# ANTHROPIC_API_KEY=
# Claude по подписке Pro/Max (docs/claude-cli.md): токен на год — `claude setup-token` в своём терминале. Только своя
# подписка; лимит общий с claude.ai и Claude Code; из РФ Claude недоступен. С токеном деплой поднимает контейнер
# claude-cli, в боте: ⚙️ → 🤖 Нейросеть → «Claude по подписке». Кончился лимит или слетел вход — вызов делает Gemini
# CLAUDE_CODE_OAUTH_TOKEN=
# Версия Claude Code CLI в контейнере (новая — сначала проверка из docs/claude-cli.md)
# CLAUDE_CODE_VERSION=2.1.303
# Оценки (W2) не берут подписку, если окно лимита (5 ч или неделя) занято на эту долю — дальше они идут в Gemini
# CLAUDE_CLI_SCORE_MAX_UTIL=0.8
# Страж healthchecks.io: Ping URL чека «job-hunter W1» (docs/stages/stage-5.md)
HC_PING_URL=
# GEMINI_MODEL=gemini-3.5-flash-lite
# Модель для разового разбора резюме (W11), можно посильнее; по умолчанию — GEMINI_MODEL
# GEMINI_PROFILE_MODEL=gemini-3.5-flash
# CLAUDE_MODEL=claude-haiku-4-5

# Владелец локального n8n — дописывает `node scripts/n8n-api.mjs setup-owner <email>`.
# Этим логином/паролем входишь в http://localhost:5678, им же пользуются скрипты.
# N8N_OWNER_EMAIL=
# N8N_OWNER_PASSWORD=

# Робот-отклик (этап 6, docs/stages/stage-6.md). Запуск и пересборка: scripts/deploy.sh --applier
# Токен API робота (n8n и scripts/applier.mjs): openssl rand -hex 24
# APPLIER_TOKEN=
# Пароль окна робота (VNC: на Mac — «Общий экран», vnc://localhost:5901; на Windows и Linux — любой VNC-клиент)
# — не длиннее 8 символов
# VNC_PASSWORD=
# Порты робота на этом компьютере: окно (VNC) и API для scripts/applier.mjs
# VNC_PORT=5901
# APPLIER_PORT=5682
# Предохранитель резюме (⚙️ → 💡 → 📤 Обновить на hh): 0 — робот только заполняет формы hh и присылает снимки, 1 — сохраняет
# RESUME_LIVE=0
# Предохранитель: 0 — робот не нажимает «Откликнуться» (сухой прогон), 1 — живые отклики
# APPLY_LIVE=0
# Предохранитель напоминаний (6.3, 🔔 на панели): 0 — робот доходит до поля в чате отклика и не пишет, 1 — отправляет
# REMIND_LIVE=0
# Фейковый режим для проверки n8n без hh (этап 6.1a)
# APPLIER_FAKE=0
# Жёсткие потолки робота сверх лимитов и темпа из ⚙️ бота: живых откликов в «день», в час и пауза между попытками (с)
# APPLIER_DAILY_CAP=100
# APPLIER_HOURLY_CAP=40
# APPLIER_MIN_GAP=15
# Потолки живых напоминаний сверх лимита из ⚙️: в «день» и в час
# APPLIER_REMIND_DAILY_CAP=30
# APPLIER_REMIND_HOURLY_CAP=10
# Название резюме на hh для сверки в окне отклика (по желанию). Если бот передал резюме вакансии (несколько резюме,
# docs/resumes.md), сверяется оно, а это не используется
# HH_RESUME_TITLE=
